{
  "schema": 1,
  "model": "pp-ocrv6-small",
  "precision": "fp32",
  "cpu_data_tiling": false,
  "components": [
    {
      "name": "detection",
      "input_dtype": "float32",
      "entries": {"kind": "long_side", "long_side": 960, "multiple": 32, "min_short_side": 64, "batch": 1, "channels": 3},
      "keep_outputs": [0],
      "output_shapes": [[1, 1, "$2", "$3"]],
      "quantize": false
    },
    {
      "name": "recognition",
      "input_dtype": "float32",
      "entries": {"kind": "fixed", "shapes": {"main": [1, 3, 48, 320]}},
      "keep_outputs": [0],
      "output_shapes": [[1, 40, 18710]],
      "quantize": false
    },
    {
      "name": "classification",
      "input_dtype": "float32",
      "entries": {"kind": "fixed", "shapes": {"main": [1, 3, 80, 160]}},
      "keep_outputs": [0],
      "output_shapes": [[1, 2]],
      "quantize": false
    }
  ],
  "model_info_checks": [
    {"path": ["task_metadata", "tasks", "ocr", "detection", "limit_side_len"], "equals": 960, "absent_means_equal": true},
    {"path": ["task_metadata", "tasks", "ocr", "recognition", "image_shape"], "equals": [3, 48, 320], "absent_means_equal": true},
    {"path": ["task_metadata", "tasks", "ocr", "classification", "component"], "equals": "classification", "absent_means_equal": false},
    {"path": ["task_metadata", "tasks", "ocr", "classification", "image_shape"], "equals": [3, 80, 160], "absent_means_equal": true}
  ]
}
